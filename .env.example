# LLM local (padrão). Sobe com `ollama serve`. Sem chave de API.
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- OpenAI (só se LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Azure OpenAI (alternativa, reaproveita padrão do tech-4) ---
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# --- Embeddings p/ RAG ---
EMBEDDINGS_MODEL=text-embedding-3-small

# --- Vector store ---
CHROMA_PERSIST_DIR=data/knowledge/.chroma

# --- Caminhos ---
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
KNOWLEDGE_DIR=data/knowledge
MODELS_DIR=models
AUDIT_DIR=data/reports/audits

# --- Configuração de runtime ---
LOG_LEVEL=INFO
DEVICE=cpu
RANDOM_STATE=42
TEST_SIZE=0.2
